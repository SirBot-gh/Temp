<?xml version="1.0"?>
<device-group>
  <entry name="TEST-DG">
    <pre-rulebase>
      <security>
        <rules>
          <entry name="pushed-pre-rule-1">
            <from><member>mgmt-zone</member></from><to><member>trust</member></to>
            <source><member>ADMIN-SUBNETS</member></source>
            <destination><member>any</member></destination>
            <application><member>ssl</member></application>
            <service><member>application-default</member></service>
            <action>allow</action>
          </entry>
        </rules>
      </security>
    </pre-rulebase>
    <post-rulebase>
      <security>
        <rules>
          <entry name="pushed-post-deny">
            <from><member>any</member></from><to><member>any</member></to>
            <source><member>any</member></source><destination><member>any</member></destination>
            <application><member>any</member></application>
            <service><member>any</member></service>
            <action>deny</action>
          </entry>
        </rules>
      </security>
    </post-rulebase>
    <address>
      <entry name="ADMIN-NET-1"><ip-netmask>10.99.50.0/24</ip-netmask></entry>
    </address>
    <address-group>
      <entry name="ADMIN-SUBNETS"><static><member>ADMIN-NET-1</member></static></entry>
    </address-group>
  </entry>
</device-group>
